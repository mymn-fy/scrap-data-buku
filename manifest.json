{
  "manifest_version": 3,
  "name": "Book Scraper & Smart Copy Calculator",
  "version": "1.0.0",
  "description": "Mengekstrak data buku dari halaman produk untuk dianalisis dan disalin.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "Icons/icon16.png",
      "24": "Icons/icon24.png",
      "32": "Icons/icon32.png",
      "48": "Icons/icon48.png",
      "128": "Icons/icon128.png"
    }
  },
  "icons": {
    "16": "Icons/icon16.png",
    "24": "Icons/icon24.png",
    "32": "Icons/icon32.png",
    "48": "Icons/icon48.png",
    "128": "Icons/icon128.png"
  },
  "theme_icons": [
    {
      "light": "Icons/icon16.png",
      "dark": "Icons/icon16-dark.png",
      "size": 16
    },
    {
      "light": "Icons/icon32.png",
      "dark": "Icons/icon32-dark.png",
      "size": 32
    },
    {
      "light": "Icons/icon48.png",
      "dark": "Icons/icon48-dark.png",
      "size": 48
    },
    {
      "light": "Icons/icon128.png",
      "dark": "Icons/icon128-dark.png",
      "size": 128
    }
  ],
  "background": {
    "service_worker": "scripts/storage.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html",
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/extractor.js",
        "scripts/utils.js",
        "scripts/config.js",
        "scripts/extractors/base.js",
        "scripts/extractors/generic.js",
        "scripts/extractors/gramedia.js",
        "scripts/extractors/anak-hebat.js",
        "scripts/extractors/minhaj-pustaka.js",
        "scripts/extractors/deepublish.js",
        "scripts/extractors/registry.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}